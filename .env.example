# 팀원용 환경변수 예시. 복사 후 프로젝트 루트의 .env에 실제 값을 채우세요.
# .env와 Firebase 서비스 계정 JSON은 Git에 올리지 않습니다.
DB_HOST=YOUR_MYSQL_HOST
DB_PORT=3306
DB_USER=YOUR_MYSQL_USER
DB_PASSWORD=YOUR_MYSQL_PASSWORD
DB_NAME=YOUR_MYSQL_DATABASE
API_HOST=0.0.0.0
API_PORT=8000


FIREBASE_PROJECT_ID=shoe-20260930
FIREBASE_DATABASE_ID=(default)
# Firebase Authentication 이메일/비밀번호 로그인을 위한 Web API Key입니다.
FIREBASE_WEB_API_KEY=YOUR_FIREBASE_WEB_API_KEY
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repository/service-account.json
