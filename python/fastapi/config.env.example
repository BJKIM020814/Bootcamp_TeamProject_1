# 프로젝트 루트 .env로 복사해서 값 입력. 실제 비밀키는 커밋하지 마세요.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=fitpick
DB_PASSWORD=
DB_NAME=fitpick
FIREBASE_PROJECT_ID=shoe-20260930
FIREBASE_DATABASE_ID=(default)
# ADC 또는 서비스 계정 경로. Firebase CLI 로그인과 Python ADC는 별개입니다.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repository/service-account.json
# contact.head_office_id FK에 존재하는 실제 본사 직원 ID
SUPPORT_HEAD_OFFICE_ID=
API_SQLITE_PATH=python/fastapi/data/app.sqlite3
API_SESSION_SECONDS=3600
API_CORS_ORIGINS=http://localhost:3000,http://localhost:8080
APP_VERSION=1.0.0
# 기존 평문 테스트 계정 로그인/최초 해시 변환을 허용할 경우에만 true
ALLOW_LEGACY_PASSWORD_LOGIN=false
