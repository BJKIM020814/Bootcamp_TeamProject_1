# MySQL 접속 정보 예시 (팀원 공유용)
# 이 파일을 복사해서 프로젝트 루트에 .env 를 만들고 실제 값을 채우세요. (.env 는 커밋 금지)
# 네이버 지도 API 키 등 다른 설정도 이 파일에 함께 추가해서 사용합니다.
DB_HOST=192.168.20.68
DB_PORT=3306
DB_USER=YOUR_MYSQL_USER
DB_PASSWORD=YOUR_MYSQL_PASSWORD
DB_NAME=shoes
API_HOST=192.168.20.68
API_PORT=8000
# Flutter 앱 실행은 ./tool/run_flutter_with_env.sh 를 사용합니다.
NAVER_MAP_CLIENT_ID=YOUR_NAVER_MAP_CLIENT_ID


FIREBASE_PROJECT_ID=shoe-20260930
FIREBASE_DATABASE_ID=(default)
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repository/service-account.json
